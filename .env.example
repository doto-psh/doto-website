# OpenAI API — used only by the server-side chatbot endpoint (/api/chat).
# The key is read via $env/dynamic/private and is NEVER exposed to the browser.
# Local dev: copy this file to `.env` and fill in your key.
# Production: set the same variables in Vercel → Settings → Environment Variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
